# Développement uniquement. Utilisez une valeur aléatoire d’au moins 50
# caractères en production et ne versionnez jamais le fichier .env réel.
DJANGO_SECRET_KEY=development-only-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DOCUMENT_PDF_MAX_BYTES=26214400
WEB_BIND_ADDRESS=127.0.0.1
WEB_HOST_PORT=8000
DB_BIND_ADDRESS=127.0.0.1
DB_HOST_PORT=5432
PAB_UID=999
PAB_GID=999
SCAN_INPUT_HOST_PATH=./scan
PAPERLESS_CONSUME_HOST_PATH=./paperless-consume
SCAN_STABILITY_SECONDS=10
SCAN_POLL_SECONDS=5
SCAN_DEFAULT_COMPANY_CODE=
SCAN_DEFAULT_DOCUMENT_TYPE_CODE=
DB_NAME=paperless
DB_USER=paperless
DB_PASSWORD=paperless
DB_HOST=db
DB_PORT=5432
