# Développement uniquement. Utilisez une valeur aléatoire d’au moins 50
# caractères en production et ne versionnez jamais le fichier .env réel.
DJANGO_SECRET_KEY=development-only-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DB_NAME=paperless
DB_USER=paperless
DB_PASSWORD=paperless
DB_HOST=db
DB_PORT=5432
